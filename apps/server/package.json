{
  "name": "@autoflow/server",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Autoflow Orchestrator: API, scheduler, robot gateway and web dashboard host",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@autoflow/flow-types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "ldapts": "^9.2.0",
    "nodemailer": "^7.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  }
}
