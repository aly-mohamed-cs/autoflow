{
  "name": "@autoflow/studio",
  "productName": "Autoflow Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Autoflow Studio - build automations without code",
  "author": "Autoflow",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
